# CloudXR device-profile overrides for the RB-Y1 Isaac Capture device.
#
# Passed to isaaccapture's CloudXRLauncher as `env_config` (via
# IsaacTeleopConfig.cloudxr_env_file; this file is the default). Format:
# KEY=value, one per line; `#` comments and blank lines ignored; $VARS / ~
# expanded. See isaaccapture/cloudxr/env_config.py::_load_env_file.
#
# The file only takes effect when this process starts the CloudXR service. A
# service that is already running keeps its own settings; the launcher lists
# the differing keys and how to restart the service.
#
# Runtime-resolved keys (XR_RUNTIME_JSON, XRT_NO_STDIN, NV_CXR_RUNTIME_DIR,
# NV_CXR_OUTPUT_DIR) are reserved and ignored if set here.

# Transport profile the runtime advertises. "Quest3" serves every WebXR client
# (Quest, Pico, desktop emulator). Other values: auto-native, AppleVisionPro.
NV_DEVICE_PROFILE=Quest3

# Input device discovery channels (both default to true; pinned for clarity).
NV_CXR_ENABLE_PUSH_DEVICES=true
NV_CXR_ENABLE_TENSOR_DATA=true

# Runtime logs to ~/.cloudxr/logs — helps debug connection issues
# (e.g. "Failed to get OpenXR system: -35").
NV_CXR_FILE_LOGGING=true
