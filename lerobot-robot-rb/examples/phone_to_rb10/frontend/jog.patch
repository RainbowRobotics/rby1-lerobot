+        // Base-frame jog buttons: held = true on that key, release = false.
+        const jogButtons = {
+            jogXMinus: 'xMinus', jogXPlus: 'xPlus',
+            jogYMinus: 'yMinus', jogYPlus: 'yPlus',
+            jogZMinus: 'zMinus', jogZPlus: 'zPlus',
+        };
+        Object.entries(jogButtons).forEach(([id, key]) => {
+            const el = this.shadowRoot.getElementById(id);
+            const start = (event) => {
+                event.preventDefault();
+                this.jog[key] = true;
+                el.classList.add('active');
+            };
+            const end = () => {
+                if (!this.jog[key]) return;
+                this.jog[key] = false;
+                el.classList.remove('active');
+            };
+            el.addEventListener('mousedown', start);
+            el.addEventListener('touchstart', start);
+            document.addEventListener('mouseup', end);
+            document.addEventListener('touchend', end);
+        });
